From 71bd882938ae24543e2e23292d1d939adf37156e Mon Sep 17 00:00:00 2001
From: alvyn16 <alvyn655@gmail.com>
Date: Sat, 10 Oct 2026 15:15:26 -0400
Subject: [PATCH] Route remaining RFU IRQ acknowledges through the host model

---
 src/librfu_intr.c    | 2 +-
 src/librfu_sio32id.c | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/librfu_intr.c b/src/librfu_intr.c
index 5ae53ab..8b84a00 100644
--- a/src/librfu_intr.c
+++ b/src/librfu_intr.c
@@ -367,7 +367,7 @@ static void STWI_set_timer_in_RAM(u8 count)
         break;
     }
     *regTMCNTH = TIMER_ENABLE | TIMER_64CLK | TIMER_256CLK | TIMER_INTR_ENABLE;
-    REG_IF = INTR_FLAG_TIMER0 << gSTWIStatus->timerSelect;
+    REG_IF_ACK(INTR_FLAG_TIMER0 << gSTWIStatus->timerSelect);
     REG_IME = 1;
 }
 
diff --git a/src/librfu_sio32id.c b/src/librfu_sio32id.c
index c40bb82..18ce787 100644
--- a/src/librfu_sio32id.c
+++ b/src/librfu_sio32id.c
@@ -65,7 +65,7 @@ static void Sio32IDInit(void)
     REG_SIOCNT = SIO_32BIT_MODE;
     REG_SIOCNT |= SIO_INTR_ENABLE | SIO_ENABLE;
     CpuFill32(0, &gRfuSIO32Id, sizeof(struct RfuSIO32Id));
-    REG_IF = INTR_FLAG_SERIAL;
+    REG_IF_ACK(INTR_FLAG_SERIAL);
 }
 
 static s32 Sio32IDMain(void)
@@ -100,7 +100,7 @@ static s32 Sio32IDMain(void)
                 REG_IME = 1;
                 REG_SIOCNT = 0;
                 REG_SIOCNT = SIO_32BIT_MODE;
-                REG_IF = INTR_FLAG_SERIAL;
+                REG_IF_ACK(INTR_FLAG_SERIAL);
                 REG_SIOCNT |= SIO_INTR_ENABLE | SIO_ENABLE;
                 REG_IME = 0;
                 REG_IE |= INTR_FLAG_SERIAL;
