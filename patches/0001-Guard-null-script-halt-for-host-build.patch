From 7ff5694d080fa9f0bbbef9976018a1c8fd4e2b93 Mon Sep 17 00:00:00 2001
From: emerald-pc <port@local.invalid>
Date: Sat, 3 Oct 2026 22:37:33 -0400
Subject: [PATCH] Guard null script halt for host build

---
 src/script.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/script.c b/src/script.c
index a953ff1..4f0ac37 100644
--- a/src/script.c
+++ b/src/script.c
@@ -103,7 +103,11 @@ bool8 RunScriptCommand(struct ScriptContext *ctx)
             if (ctx->scriptPtr == gNullScriptPtr)
             {
                 while (1)
+#ifdef PORT_PC
+                    __builtin_trap(); // A null script is fatal on the host.
+#else
                     asm("svc 2"); // HALT
+#endif
             }
 
             cmdCode = *(ctx->scriptPtr);
-- 
