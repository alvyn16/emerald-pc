From: alvyn16 <alvyn655@gmail.com>
Date: Sun, 11 Oct 2026 01:38:01 -0400
Subject: [PATCH] Observe host DMA stop through the channel backend

---
 include/gba/macro.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/include/gba/macro.h b/include/gba/macro.h
index c8c58ea..a5a0a6c 100644
--- a/include/gba/macro.h
+++ b/include/gba/macro.h
@@ -248,6 +248,9 @@
 #define DmaClear16Defvars(dmaNum, dest, size) DmaClearDefvars(dmaNum, dest, size, 16)
 #define DmaClear32Defvars(dmaNum, dest, size) DmaClearDefvars(dmaNum, dest, size, 32)
 
+#ifdef PORT_PC
+#define DmaStop(dmaNum) PortDma_Stop(dmaNum)
+#else
 #define DmaStop(dmaNum)                                         \
 {                                                               \
     vu16 *dmaRegs = (vu16 *)REG_ADDR_DMA##dmaNum;               \
@@ -255,6 +258,7 @@
     dmaRegs[5] &= ~DMA_ENABLE;                                  \
     dmaRegs[5];                                                 \
 }
+#endif
 
 #define IntrEnable(flags)                                       \
 {                                                               \
