From 13816476b2e419be1c06ab4ecdf61c0836486706 Mon Sep 17 00:00:00 2001
From: alvyn16 <alvyn655@gmail.com>
Date: Thu, 15 Oct 2026 22:34:36 -0400
Subject: [PATCH] Bound host saved object scripts to the map template count

---
 src/overworld.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/overworld.c b/src/overworld.c
index 244e022..fd44c3a 100644
--- a/src/overworld.c
+++ b/src/overworld.c
@@ -487,7 +487,13 @@ void LoadSaveblockObjEventScripts(void)
     s32 i;
 
     for (i = 0; i < OBJECT_EVENT_TEMPLATES_COUNT; i++)
+#ifdef PORT_PC
+        savObjTemplates[i].script =
+            mapHeaderObjTemplates != NULL && i < gMapHeader.events->objectEventCount
+            ? mapHeaderObjTemplates[i].script : NULL;
+#else
         savObjTemplates[i].script = mapHeaderObjTemplates[i].script;
+#endif
 }
 
 void SetObjEventTemplateCoords(u8 localId, s16 x, s16 y)
